---
import { CodeXml } from '@lucide/astro';
import StatusLed from '../ui/StatusLed.astro';

const repoUrl = 'https://github.com/qq076qq076/ai-build-stage';
---

<footer>
  <div class="shell footer-inner">
    <div>
      <StatusLed>Static system online</StatusLed>
      <p>作品、推薦與評論皆可追溯至公開 GitHub Issue。</p>
    </div>
    <a href={repoUrl} target="_blank" rel="noopener noreferrer"><CodeXml size={18} />檢視原始碼</a>
  </div>
</footer>

<style>
  footer { margin-top: 6rem; padding-block: 2.5rem; border-top: 1px solid rgb(255 255 255 / 55%); }
  .footer-inner { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  p { margin: 0.75rem 0 0; color: var(--color-ink-muted); font-size: 0.9rem; }
  a { display: inline-flex; min-height: 3rem; align-items: center; gap: 0.5rem; color: var(--color-ink-muted); font-weight: 700; text-decoration: none; }
  a:hover { color: var(--color-accent-dark); }
  @media (max-width: 40rem) { .footer-inner { align-items: start; flex-direction: column; } }
</style>
