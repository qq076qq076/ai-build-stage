---
import ProjectExplorer from '../../components/catalog/ProjectExplorer.astro';
import { loadCatalog } from '../../lib/catalog';
import BaseLayout from '../../layouts/BaseLayout.astro';

const catalog = loadCatalog();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="探索 AI 作品｜AI Build Stage" description="搜尋與篩選經過人工審核、可追溯至 GitHub Issue 的 AI 製作專案。" canonicalPath={`${base}projects/`}>
  <section class="catalog-shell shell">
    <header class="page-header">
      <p class="technical-label">Public project registry</p>
      <h1 class="embossed-text">探索 AI 作品</h1>
      <p>每件上架作品都對應一張通過審核的 GitHub Issue。你可以自由瀏覽；推薦或留言時再前往 GitHub。</p>
      <span class="sync-time">CATALOG SYNC / <time datetime={catalog.generatedAt}>{new Date(catalog.generatedAt).toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' })}</time></span>
    </header>
    <ProjectExplorer projects={catalog.projects} />
  </section>
</BaseLayout>

<style>
  .catalog-shell { padding-block: clamp(2.25rem, 5vw, 4rem); }
  .page-header { display: grid; grid-template-areas: "label copy" "title copy" "title sync"; grid-template-columns: minmax(17rem, 0.8fr) minmax(22rem, 1.2fr); gap: 0.45rem clamp(2rem, 6vw, 5rem); align-items: end; margin-bottom: 2.25rem; }
  .page-header > .technical-label { grid-area: label; margin: 0; color: var(--color-accent-dark); }
  h1 { grid-area: title; margin: 0; font-size: clamp(2.7rem, 5vw, 4.4rem); line-height: 0.96; letter-spacing: -0.055em; }
  .page-header > p:not(.technical-label) { grid-area: copy; max-width: 62ch; margin: 0; color: var(--color-ink-muted); font-size: 1rem; }
  .sync-time { display: inline-block; grid-area: sync; margin-top: 0.45rem; color: var(--color-ink-muted); font: 600 0.7rem/1.4 var(--font-mono); letter-spacing: 0.06em; }
  @media (max-width: 48rem) {
    .page-header { display: block; margin-bottom: 1.75rem; }
    h1 { margin-top: 0.45rem; }
    .page-header > p:not(.technical-label) { margin-top: 0.85rem; }
    .sync-time { margin-top: 0.85rem; }
  }
</style>
