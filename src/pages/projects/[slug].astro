---
import { ArrowLeft, ArrowUpRight, CodeXml, MessageSquare, ThumbsUp } from '@lucide/astro';
import PhysicalButton from '../../components/ui/PhysicalButton.astro';
import StatusLed from '../../components/ui/StatusLed.astro';
import { categoryLabels, loadCatalog, pricingLabels, type Project } from '../../lib/catalog';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return loadCatalog().projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: Project; }

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const projectPath = `${base}projects/${project.slug}/`;
const commentUrl = `${project.issue.url}#new_comment_field`;
---

<BaseLayout title={`${project.title}｜AI Build Stage`} description={project.tagline} canonicalPath={projectPath}>
  <article class="detail shell">
    <a class="back-link" href={`${base}projects/`}><ArrowLeft size={18} />返回所有作品</a>
    <header class="detail-header">
      <div>
        <StatusLed>Verified submission</StatusLed>
        <p class="technical-label category">{categoryLabels[project.category]} / ISSUE #{project.issue.number}</p>
        <h1 class="embossed-text">{project.title}</h1>
        <p class="tagline">{project.tagline}</p>
        <div class="actions">
          <PhysicalButton href={project.demoUrl} variant="primary" external>開啟作品 <ArrowUpRight size={18} /></PhysicalButton>
          {project.sourceUrl && <PhysicalButton href={project.sourceUrl} external><CodeXml size={18} />查看原始碼</PhysicalButton>}
        </div>
      </div>
      <aside class="telemetry screen-grid">
        <p class="technical-label">Public telemetry</p>
        <div class="telemetry-actions">
          <a
            class="telemetry-action"
            href={project.issue.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`前往 GitHub 推薦 ${project.title}，目前有 ${project.issue.reactions.plusOne} 次推薦`}
          >
            <span class="telemetry-label"><ThumbsUp size={18} />推薦</span>
            <strong>{project.issue.reactions.plusOne}</strong>
            <span class="telemetry-link">前往 GitHub 按 👍</span>
          </a>
          <a
            class="telemetry-action"
            href={commentUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`前往 GitHub 評論 ${project.title}，目前有 ${project.issue.commentsCount} 則評論`}
          >
            <span class="telemetry-label"><MessageSquare size={18} />評論</span>
            <strong>{project.issue.commentsCount}</strong>
            <span class="telemetry-link">查看或留下評論</span>
          </a>
        </div>
        <p class="telemetry-note">互動將記錄在 GitHub Issue #{project.issue.number}</p>
      </aside>
    </header>

    <div class="detail-grid">
      <section class="content-panel">
        <p class="technical-label">Project brief</p><h2>作品介紹</h2><p>{project.description}</p>
        {project.buildStory && <><h2>AI 如何參與</h2><p>{project.buildStory}</p></>}
      </section>
      <aside class="spec-panel">
        <p class="technical-label">Project data</p>
        <dl>
          <div><dt>創作者</dt><dd>{project.creator.url ? <a href={project.creator.url} target="_blank" rel="noopener noreferrer">{project.creator.name}</a> : project.creator.name}</dd></div>
          <div><dt>價格</dt><dd>{pricingLabels[project.pricing]}</dd></div>
          <div><dt>AI 工具</dt><dd>{project.aiTools.join('、')}</dd></div>
          <div><dt>標籤</dt><dd>{project.tags.length ? project.tags.join('、') : '未指定'}</dd></div>
          <div><dt>語言</dt><dd>{project.languages.length ? project.languages.join('、') : '未指定'}</dd></div>
          <div><dt>上架時間</dt><dd><time datetime={project.approvedAt}>{new Date(project.approvedAt).toLocaleDateString('zh-TW')}</time></dd></div>
        </dl>
      </aside>
    </div>

  </article>
</BaseLayout>

<style>
  .detail { padding-block: 3rem 1rem; }
  .back-link { display: inline-flex; min-height: 3rem; align-items: center; gap: 0.5rem; color: var(--color-ink-muted); font-size: 0.85rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { color: var(--color-accent-dark); }
  .detail-header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.42fr); gap: clamp(2rem, 6vw, 5rem); align-items: end; padding-block: 3rem 4rem; }
  .category { margin: 1.5rem 0 0; color: var(--color-accent-dark); }
  h1 { max-width: 13ch; margin: 0.65rem 0 0; font-size: clamp(3.2rem, 8vw, 6.5rem); line-height: 0.95; letter-spacing: -0.06em; }
  .tagline { max-width: 58ch; margin: 1.5rem 0 0; color: var(--color-ink-muted); font-size: 1.18rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .telemetry { padding: 1.5rem; border: 3px solid #545e63; border-radius: var(--radius-lg); color: #e1e9e5; background-color: var(--color-dark-panel); box-shadow: inset 0.4rem 0.4rem 0.8rem #101314, var(--shadow-card); }
  .telemetry > p { margin: 0; color: #92a19b; }
  .telemetry-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin: 1.5rem 0 1rem; }
  .telemetry-action { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; padding: 1rem; border: 1px solid rgb(168 178 189 / 18%); border-radius: var(--radius-md); color: #d8e2de; background: rgb(255 255 255 / 3%); text-decoration: none; transition: border-color 150ms ease, background 150ms ease, transform 150ms ease; }
  .telemetry-action:hover { border-color: var(--color-accent); background: rgb(193 255 67 / 8%); transform: translateY(-2px); }
  .telemetry-action:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  .telemetry-label { display: flex; align-items: center; gap: 0.45rem; color: #9eada7; font-size: 0.75rem; }
  .telemetry-action strong { margin-top: 0.7rem; color: var(--color-accent); font: 500 2rem/1 var(--font-mono); }
  .telemetry-link { margin-top: 0.8rem; color: #d8e2de; font: 600 0.68rem/1.5 var(--font-mono); }
  .telemetry-note { font: 500 0.68rem/1.5 var(--font-mono); }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr); gap: 2rem; }
  .content-panel, .spec-panel { padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid rgb(255 255 255 / 55%); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .content-panel { background: rgb(240 242 245 / 52%); }
  .content-panel > .technical-label, .spec-panel > .technical-label { margin: 0; color: var(--color-accent-dark); }
  h2 { margin: 0.6rem 0 0; font-size: 1.75rem; letter-spacing: -0.025em; }
  .content-panel > p:not(.technical-label) { max-width: 65ch; color: var(--color-ink-muted); white-space: pre-line; }
  .content-panel h2:not(:first-of-type) { margin-top: 2.2rem; }
  .spec-panel dl { margin: 1.5rem 0 0; }
  .spec-panel dl div { padding: 0.85rem 0; border-top: 1px solid rgb(163 177 198 / 35%); }
  .spec-panel dt { color: var(--color-ink-muted); font: 600 0.68rem/1.4 var(--font-mono); letter-spacing: 0.05em; text-transform: uppercase; }
  .spec-panel dd { margin: 0.25rem 0 0; font-weight: 650; }
  .spec-panel a { color: var(--color-accent-dark); }
  @media (max-width: 52rem) { .detail-header, .detail-grid { grid-template-columns: 1fr; } }
  @media (max-width: 36rem) { .actions { display: grid; } }
</style>
