---
import { ArrowRight, CodeXml, ShieldCheck, Sparkles } from '@lucide/astro';
import CatalogConsole from '../components/home/CatalogConsole.astro';
import ProjectCard from '../components/catalog/ProjectCard.astro';
import BoltedPanel from '../components/ui/BoltedPanel.astro';
import PhysicalButton from '../components/ui/PhysicalButton.astro';
import StatusLed from '../components/ui/StatusLed.astro';
import { loadCatalog } from '../lib/catalog';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const path = (value: string) => `${base}${value.replace(/^\//, '')}`;
const submitUrl = 'https://github.com/qq076qq076/ai-build-stage/issues/new?template=project-submission.yml';
const catalog = loadCatalog();
const featured = catalog.projects.filter((project) => project.featured).slice(0, 3);
const latest = featured.length ? featured : [...catalog.projects].sort((a, b) => Date.parse(b.approvedAt) - Date.parse(a.approvedAt)).slice(0, 3);
---

<BaseLayout canonicalPath={base}>
  <section class="hero shell">
    <div class="hero-copy">
      <StatusLed pulse>System operational</StatusLed>
      <p class="eyebrow technical-label">Verified AI project registry</p>
      <h1 class="embossed-text">AI 做出的作品，<br /><span>值得被看見。</span></h1>
      <p class="intro">探索真實上線的 AI 專案。每件作品都連回一張經過人工審核的 GitHub Issue，推薦與評論公開可查。</p>
      <div class="hero-actions">
        <PhysicalButton href={path('/projects/')} variant="primary">
          探索作品 <ArrowRight size={18} stroke-width={2} />
        </PhysicalButton>
        <PhysicalButton href={submitUrl} external>
          <CodeXml size={18} stroke-width={1.7} /> 投稿作品
        </PhysicalButton>
      </div>
      <p class="microcopy">不需註冊新帳號。投稿、推薦與評論都使用 GitHub。</p>
    </div>
    <CatalogConsole count={catalog.projects.length} generatedAt={catalog.generatedAt} />
  </section>

  <section class="latest shell" aria-labelledby="latest-title">
    <header class="section-heading">
      <div><p class="technical-label">Current inventory</p><h2 id="latest-title">{featured.length ? '精選作品' : '最新上架'}</h2></div>
      <a href={path('/projects/')}>查看全部 <ArrowRight size={17} /></a>
    </header>
    {latest.length > 0 ? (
      <div class="latest-grid">{latest.map((project) => <ProjectCard project={project} />)}</div>
    ) : (
      <div class="catalog-empty"><p class="technical-label">STAGE READY / 000</p><h3>等待第一件通過審核的作品</h3><p>公開 catalog 目前是空的。投稿完成並取得 verified 標記後，作品會自動出現在這裡。</p><PhysicalButton href={submitUrl} external>投稿作品</PhysicalButton></div>
    )}
  </section>

  <section class="principles shell" aria-labelledby="principles-title">
    <header>
      <p class="technical-label">Operating principles</p>
      <h2 id="principles-title">一套透明、可追溯的展示流程</h2>
    </header>
    <div class="principle-grid">
      <BoltedPanel tag="article" class="principle-card">
        <div class="principle-meta"><span class="principle-icon"><Sparkles size={26} stroke-width={1.5} /></span><p class="technical-label">01 / Submit</p></div>
        <h3>用 Issue 投稿</h3>
        <p>依照精簡表單提供作品名稱、介紹、連結與使用的 AI 工具。</p>
      </BoltedPanel>
      <BoltedPanel tag="article" class="principle-card">
        <div class="principle-meta"><span class="principle-icon"><ShieldCheck size={26} stroke-width={1.5} /></span><p class="technical-label">02 / Verify</p></div>
        <h3>人工審核上架</h3>
        <p>只有同時取得 approved 與 verified 標記的作品會出現在網站。</p>
      </BoltedPanel>
      <BoltedPanel tag="article" class="principle-card">
        <div class="principle-meta"><span class="principle-icon"><CodeXml size={26} stroke-width={1.5} /></span><p class="technical-label">03 / Respond</p></div>
        <h3>互動回到 GitHub</h3>
        <p>推薦與留言保留在原始 Issue，不建立另一套不透明的社群資料庫。</p>
      </BoltedPanel>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
    min-height: calc(100vh - 5rem);
    padding-block: clamp(4rem, 10vw, 8rem);
  }
  .hero-copy { max-width: 40rem; }
  .eyebrow { margin: 2rem 0 1rem; color: var(--color-accent-dark); }
  h1 { margin: 0; font-size: clamp(3.2rem, 7vw, 5.8rem); font-weight: 800; letter-spacing: -0.055em; line-height: 0.98; }
  h1 span { color: var(--color-accent-dark); }
  .intro { max-width: 59ch; margin: 1.8rem 0 0; color: var(--color-ink-muted); font-size: clamp(1.05rem, 2vw, 1.2rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.2rem; }
  .microcopy { margin: 1.2rem 0 0; color: var(--color-ink-muted); font: 500 0.75rem/1.5 var(--font-mono); }
  .principles { padding-block: 3rem 2rem; }
  .latest { padding-block: 2rem 5rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  .section-heading p { margin: 0; color: var(--color-accent-dark); }
  .section-heading a { display: inline-flex; min-height: 3rem; align-items: center; gap: 0.4rem; color: var(--color-ink-muted); font-size: 0.85rem; font-weight: 800; text-decoration: none; }
  .section-heading a:hover { color: var(--color-accent-dark); }
  .latest-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .catalog-empty { padding: clamp(2.5rem, 7vw, 4.5rem); border-radius: var(--radius-xl); text-align: center; box-shadow: var(--shadow-recessed); }
  .catalog-empty .technical-label { margin: 0; color: var(--color-accent-dark); }
  .catalog-empty h3 { margin: 0.8rem 0 0; font-size: clamp(1.6rem, 4vw, 2.4rem); }
  .catalog-empty > p:not(.technical-label) { max-width: 42rem; margin: 0.8rem auto 1.6rem; color: var(--color-ink-muted); }
  .principles > header { max-width: 45rem; margin-bottom: 2.5rem; }
  .principles header p { color: var(--color-accent-dark); }
  h2 { margin: 0.5rem 0 0; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.12; letter-spacing: -0.035em; }
  .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .principle-grid :global(.principle-card) { min-height: 19rem; transition: transform 300ms var(--ease-mechanical), box-shadow 300ms ease; }
  .principle-grid :global(.principle-card:hover) { box-shadow: var(--shadow-floating); transform: translateY(-4px); }
  .principle-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .principle-icon { display: inline-flex; flex: 0 0 auto; color: var(--color-accent-dark); }
  .principle-meta .technical-label { margin: 0; color: var(--color-accent-dark); text-align: right; }
  .principle-grid h3 { margin: 2rem 0 0; font-size: 1.35rem; }
  .principle-grid :global(.principle-card) > p:last-child { margin: 0.8rem 0 0; color: var(--color-ink-muted); }
  @media (max-width: 56rem) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-copy { max-width: 44rem; }
    .principle-grid { grid-template-columns: 1fr; }
    .latest-grid { grid-template-columns: 1fr; }
    .principle-grid :global(.principle-card) { min-height: 0; }
  }
  @media (max-width: 36rem) {
    .hero { padding-block: 3.5rem; }
    .hero-actions { display: grid; }
    .section-heading { align-items: start; flex-direction: column; }
  }
</style>
