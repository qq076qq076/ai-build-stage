---
import { Check, ExternalLink, ShieldAlert } from '@lucide/astro';
import BoltedPanel from '../components/ui/BoltedPanel.astro';
import PhysicalButton from '../components/ui/PhysicalButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const submitUrl = 'https://github.com/qq076qq076/ai-build-stage/issues/new?template=project-submission.yml';
---

<BaseLayout title="投稿規範｜AI Build Stage" description="了解 AI Build Stage 的投稿資格、審核標準與公開資料規則。" canonicalPath={`${base}guidelines/`}>
  <article class="document shell">
    <header><p class="technical-label">Submission protocol</p><h1>投稿規範</h1><p>表單刻意保持精簡。請提供可公開檢視的作品，以及足以讓審核者理解 AI 如何參與的資訊。</p></header>
    <div class="document-grid">
      <BoltedPanel tag="section"><Check size={28} aria-hidden="true" /><h2>可以投稿</h2><ul><li>已能公開使用或檢視的作品</li><li>確實使用至少一項 AI 工具製作</li><li>你有權分享的文字與連結</li><li>願意接受公開評論與推薦</li></ul></BoltedPanel>
      <BoltedPanel tag="section"><ShieldAlert size={28} aria-hidden="true" /><h2>不接受</h2><ul><li>惡意程式、詐騙或危險連結</li><li>侵權、冒用或未經授權的內容</li><li>仇恨、騷擾或違法內容</li><li>只有構想、沒有可檢視成果的投稿</li></ul></BoltedPanel>
    </div>
    <section class="steps"><p class="technical-label">Review sequence</p><h2>上架流程</h2><ol><li><strong>提交 Issue</strong><span>填寫五個必要項目，其他資料可選填。</span></li><li><strong>人工審核</strong><span>維護者檢查連結、內容與是否重複。</span></li><li><strong>公開上架</strong><span>取得 approved 與 verified 後自動出現在網站。</span></li></ol></section>
    <section class="cta"><div><p class="technical-label">Ready to submit</p><h2>把作品送上舞台</h2><p>GitHub 會保存你的投稿內容與後續互動。</p></div><PhysicalButton href={submitUrl} variant="primary" external>開啟投稿表單 <ExternalLink size={18} /></PhysicalButton></section>
  </article>
</BaseLayout>

<style>
  .document { padding-block: clamp(4rem, 9vw, 7rem); }
  header { max-width: 48rem; }
  header .technical-label, .steps > .technical-label, .cta .technical-label { margin: 0; color: var(--color-accent-dark); }
  h1 { margin: 0.6rem 0 0; font-size: clamp(3.2rem, 8vw, 6rem); letter-spacing: -0.06em; line-height: 1; }
  header > p:last-child, .cta p:last-child { max-width: 62ch; color: var(--color-ink-muted); font-size: 1.08rem; }
  .document-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 4rem; }
  .document-grid section { padding: 2.5rem; }
  .document-grid :global(svg) { color: var(--color-accent-dark); }
  h2 { margin: 1rem 0 0; font-size: 1.7rem; }
  ul { display: grid; gap: 0.65rem; padding-left: 1.2rem; color: var(--color-ink-muted); }
  .steps { margin-top: 5rem; }
  .steps > h2 { font-size: 2.5rem; }
  ol { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; padding: 0; counter-reset: steps; list-style: none; }
  ol li { position: relative; padding: 1.5rem 1.2rem 1.5rem 4.5rem; border-top: 2px solid var(--color-shadow-deep); counter-increment: steps; }
  ol li::before { position: absolute; top: 1.2rem; left: 0.2rem; display: grid; width: 3rem; height: 3rem; place-items: center; border-radius: 50%; color: white; background: var(--color-accent); box-shadow: var(--shadow-accent); content: counter(steps, decimal-leading-zero); font: 700 0.72rem/1 var(--font-mono); }
  ol strong, ol span { display: block; } ol span { margin-top: 0.35rem; color: var(--color-ink-muted); font-size: 0.9rem; }
  .cta { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 5rem; padding: clamp(2rem, 5vw, 3.5rem); border-radius: var(--radius-xl); color: white; background: var(--color-dark-panel); box-shadow: var(--shadow-floating); }
  .cta h2 { margin-top: 0.5rem; } .cta .technical-label { color: #ff7682; } .cta p:last-child { margin-bottom: 0; color: var(--color-dark-panel-muted); }
  @media (max-width: 46rem) { .document-grid, ol { grid-template-columns: 1fr; } .cta { align-items: stretch; flex-direction: column; } }
</style>
